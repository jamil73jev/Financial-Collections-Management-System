# ============================================================
# SIGECO — Variables de Entorno
# ============================================================
# INSTRUCCIONES:
#   1. Copia este archivo como .env  (cp .env.example .env)
#   2. Edita los valores marcados con *** CAMBIAR ***
#   3. NUNCA subas .env a Git (ya está en .gitignore)
# ============================================================

# ── MongoDB ───────────────────────────────────────────────
# Sin autenticación (desarrollo local):
MONGO_URI=mongodb://localhost:27017

# Con autenticación (producción — RECOMENDADO):
# MONGO_URI=mongodb://sigeco_app:TU_PASSWORD_AQUI@localhost:27017/Base1%2C5?authSource=Base1%2C5

DB_NAME=Base1,5
COL_CONTRIB=Thunder

# ── API ───────────────────────────────────────────────────
PORT=8000

# CORS: en producción, reemplaza * con el dominio real
# Ejemplo: CORS_ORIGINS=http://sigeco.municipio.gob.ec,https://sigeco.municipio.gob.ec
CORS_ORIGINS=*

# ── JWT (¡¡¡CAMBIAR EN PRODUCCIÓN!!!) ─────────────────────
# Genera una clave segura con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CAMBIA_ESTE_SECRETO_POR_UNO_SEGURO_DE_AL_MENOS_32_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8

# ── Email (Fase 2) ─────────────────────────────────────────
# SMTP_HOST=smtp.municipio.gob.ec
# SMTP_PORT=587
# SMTP_USER=sigeco@municipio.gob.ec
# SMTP_PASS=PASSWORD_SMTP_AQUI
# SMTP_FROM=Control Financiero <sigeco@municipio.gob.ec>

# ── Entorno ────────────────────────────────────────────────
# Valores: development | production
APP_ENV=development
