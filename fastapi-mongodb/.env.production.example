# ============================================================
# SIGECO MVP — Variables de Entorno para PRODUCCIÓN
# ============================================================
# INSTRUCCIONES:
#   1. Copia este archivo como ".env" en la carpeta raíz
#   2. Rellena TODOS los valores marcados con <CAMBIAR>
#   3. NUNCA subas el .env real a GitHub (ya está en .gitignore)
# ============================================================

# ── MongoDB Atlas ────────────────────────────────────────────
# Obtener desde: Atlas Dashboard → Connect → Drivers
# Formato: mongodb+srv://usuario:contraseña@cluster0.xxxxx.mongodb.net
MONGO_URI=mongodb+srv://<USUARIO>:<PASSWORD>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Nombre de la base de datos (NO cambiar)
DB_NAME=Thunder

# Nombre de la colección principal (NO cambiar)
COL_CONTRIB=Base1,5

# ── Seguridad JWT ────────────────────────────────────────────
# IMPORTANTE: Cambiar por una clave aleatoria de mínimo 32 caracteres
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=<CAMBIAR_POR_CLAVE_SECRETA_DE_32_CHARS>

JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8

# ── Servidor ─────────────────────────────────────────────────
PORT=8000

# URL de tu frontend en Render (se asigna automáticamente)
# Ejemplo: https://sigeco-mvp.onrender.com
CORS_ORIGINS=https://<TU-APP>.onrender.com

# ── Power BI / BI Tools ──────────────────────────────────────
# Token estático para conectar Power BI Desktop al API
# Generar con: python -c "import secrets; print(secrets.token_hex(24))"
POWERBI_TOKEN=<CAMBIAR_TOKEN_POWERBI>

# ── Campañas masivas ─────────────────────────────────────────
# Máximo de contribuyentes por campaña
CAMPANA_LIMITE=50000

# ── Email (opcional) ─────────────────────────────────────────
# Solo necesario si se usan notificaciones por correo
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<TU_CORREO>@gmail.com
SMTP_PASS=<CONTRASEÑA_APP_GMAIL>
SMTP_FROM=SIGECO Municipio de Guayaquil <notificaciones@municipio.gob.ec>
